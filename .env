# AdminPC-Server 환경변수 설정
# 이 파일을 복사해서 .env 파일로 사용하세요
# cp .env.example .env

# ── 데이터베이스 ──────────────────────────────
DB_NAME=inspection_logs.db
USERS_DB_NAME=users.db

# ── JWT 설정 ──────────────────────────────────
# 운영 환경에서는 반드시 복잡한 값으로 변경하세요
# 미설정 시 서버 실행마다 랜덤 키가 생성되어 재시작 시 기존 토큰이 무효화됩니다.
JWT_SECRET=capstone-vision-mate-2026-secure
JWT_EXPIRY_HOURS=24

# ── 내부 통신 보안 ────────────────────────────
# MobileServer ↔ AdminPC Server 간 인증용 비밀키
INTERNAL_SECRET=capstone2026

# ── CORS 허용 출처 ────────────────────────────
# 프론트엔드 주소를 쉼표로 구분하여 설정
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.0.5:5173
